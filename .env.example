# Optional — without this, evals fall back to a heuristic and demo_app.py uses canned responses.
# The whole project runs fully offline without any keys set.
ANTHROPIC_API_KEY=

# Optional — without this, alerts just print to console instead of posting to Slack.
SLACK_WEBHOOK_URL=

# Override if you point the demo script at a deployed instance instead of localhost
MONITOR_API_URL=http://localhost:8000
