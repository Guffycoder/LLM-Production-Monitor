{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(docs|openapi.json|log|traces|metrics|alerts|health)(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/$1"
    }
  ]
}
