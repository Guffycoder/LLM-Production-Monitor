{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/log", "destination": "/api/index.py" },
    { "source": "/traces(.*)", "destination": "/api/index.py" },
    { "source": "/metrics(.*)", "destination": "/api/index.py" },
    { "source": "/alerts(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" }
  ]
}
